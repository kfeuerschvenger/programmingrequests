FROM node:26.13.0-alpine3.24

WORKDIR /frontend

COPY package*.json .

RUN npm ci

COPY . .

# The dev server reads it at start, so the variable stays in the image environment. Blank leaves the image tags out.
ARG VITE_SITE_URL=
ENV VITE_SITE_URL=${VITE_SITE_URL}

EXPOSE 3000

CMD ["npm", "run", "dev"]