server {
    listen 80;

    # Client address. With no set_real_ip_from entry, $remote_addr is the TCP peer and X-Forwarded-For from the client is ignored.
    # The entrypoint script 25-trusted-edge-proxies.sh writes one set_real_ip_from line per entry of TRUSTED_EDGE_PROXIES, the outer reverse proxies allowed to state the client address.
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    include /etc/nginx/trusted-edge-proxies.conf;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri /index.html;
    }

    # Only /api reaches the backend. X-Forwarded-For is overwritten with the address resolved above, never extended, so a value sent by the client cannot reach the API.
    location /api/ {
        proxy_pass http://api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
