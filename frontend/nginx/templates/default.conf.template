# One entry per trusted edge proxy, generated by 25-trusted-edge-proxies.sh: $trusted_edge is 1 when the TCP peer is such a proxy and 0 otherwise. $realip_remote_addr is the peer address before the real_ip module replaces $remote_addr.
include /etc/nginx/trusted-edge-geo.conf;

# Scheme and port the visitor used. The edge may state them in X-Forwarded-Proto and X-Forwarded-Port, but only a trusted edge proxy is believed and only a valid value is accepted; every other peer gets what this server saw.
map "$trusted_edge:$http_x_forwarded_proto" $forwarded_proto {
    default $scheme;
    "1:https" https;
    "1:http" http;
}

# A trusted edge's port is accepted only as a decimal number from 1 to 65535 without leading zeros. When it sends https and no port, the port is 443. Anything else falls back to the port this server saw.
map "$trusted_edge:$http_x_forwarded_proto:$http_x_forwarded_port" $forwarded_port {
    default $server_port;
    "1:https:" 443;
    "~^1:[A-Za-z]*:(?<edge_port>[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$" $edge_port;
}

# HSTS only when the visitor is on https: sent over plain http it would be ignored by browsers and mislead anyone reading the headers. An empty value makes add_header skip the header.
map $forwarded_proto $hsts_header {
    default "";
    https "max-age=31536000";
}

server_tokens off;

gzip on;
gzip_vary on;
gzip_min_length 256;
gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

server {
    listen 80;

    # Client address. With no set_real_ip_from entry, $remote_addr is the TCP peer and X-Forwarded-For from the client is ignored.
    # The entrypoint script 25-trusted-edge-proxies.sh writes one set_real_ip_from line per entry of TRUSTED_EDGE_PROXIES, the outer reverse proxies allowed to state the client address.
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    include /etc/nginx/trusted-edge-proxies.conf;

    root /usr/share/nginx/html;

    # The shell is never cached, so a deploy is picked up at once. The hashed files it points to are cached for good.
    location = /index.html {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # File names carry a content hash, so a cached copy never goes stale. A missing file is a plain 404, never the SPA shell.
    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Any other file that exists (the favicon, the logo) is cached for 7 days; every other path is a client-side route.
    location / {
        try_files $uri @spa;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=604800";
    }

    location @spa {
        rewrite ^ /index.html break;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Only /api reaches the backend. Every forwarding header is overwritten or cleared, never extended, so a value sent by the client cannot reach the API. X-Forwarded-For carries the address resolved above.
    # code-quests-api is the API's alias on app_net: a service named api on another network that web joins cannot take its place.
    # nginx resolves a fixed host name once, at start. A variable in proxy_pass is resolved at request time through Docker's DNS (127.0.0.11), so a recreated api container is found without restarting web. With no URI in proxy_pass, the request URI, /api/ included, goes upstream unchanged.
    location /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        resolver_timeout 2s;
        set $api_upstream http://code-quests-api:8080;
        proxy_pass $api_upstream;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";

        # The headers below are set here for every response, so an upstream copy would be a duplicate.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Strict-Transport-Security;
        include /etc/nginx/security-headers.conf;
    }
}
