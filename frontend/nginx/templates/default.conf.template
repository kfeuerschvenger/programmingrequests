server {
    listen 80;

    # Client address. With no set_real_ip_from entry, $remote_addr is the TCP peer and X-Forwarded-For from the client is ignored.
    # The entrypoint script 25-trusted-edge-proxies.sh writes one set_real_ip_from line per entry of TRUSTED_EDGE_PROXIES, the outer reverse proxies allowed to state the client address.
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    include /etc/nginx/trusted-edge-proxies.conf;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri /index.html;
    }

    # Only /api reaches the backend. Every forwarding header is overwritten or cleared, never extended, so a value sent by the client cannot reach the API. X-Forwarded-For carries the address resolved above.
    # code-quests-api is the API's alias on app_net: a service named api on another network that web joins cannot take its place.
    location /api/ {
        proxy_pass http://code-quests-api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";
    }
}
