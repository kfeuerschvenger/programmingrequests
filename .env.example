MYSQL_DATABASE=code_quests
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=code_quests_app
MYSQL_PASSWORD=change-me
# Generate with: openssl rand -base64 48 (at least 32 bytes, required)
VOTER_HASH_SECRET=change-me-to-at-least-32-random-bytes
# Optional: outer reverse proxies (IPs or CIDR ranges, comma or space separated) allowed to state the client address. Empty trusts nobody.
TRUSTED_EDGE_PROXIES=
# Optional: regex of the proxy that may set X-Forwarded-For for the API. Defaults to the app_net subnet minus its gateway. A blank value stops startup.
# TRUSTED_PROXIES=
# Optional: subnet of the internal web/api network. Change it together with TRUSTED_PROXIES.
# APP_NET_SUBNET=