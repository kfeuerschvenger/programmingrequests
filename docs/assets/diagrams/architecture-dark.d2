# Code Quests architecture, dark variant: the light diagram with night tones of the same six hues.
...@architecture

style.fill: "#1A120D"

classes.parchment.style: {fill: "#E9DAB8"; stroke: "#F3E6C8"; font-color: "#2B2622"}
classes.wood.style: {fill: "#4A3626"; stroke: "#C8962E"; font-color: "#F3E6C8"}
classes.brass.style: {fill: "#4A3811"; stroke: "#C8962E"; font-color: "#F6E7BE"}
classes.guild.style: {fill: "#1F3A1D"; stroke: "#7DB077"; font-color: "#D9E8D5"}
classes.wax.style: {fill: "#4F1B18"; stroke: "#D9564D"; font-color: "#F6DAD6"}
classes.group-wood.style: {fill: "#241811"; stroke: "#B59A78"; font-color: "#F3E6C8"}
classes.group-brass.style: {fill: "#271D0C"; stroke: "#C8962E"; font-color: "#F6E7BE"}
classes.group-guild.style: {fill: "#142414"; stroke: "#7DB077"; font-color: "#D9E8D5"}
classes.group-wax.style: {fill: "#2A1210"; stroke: "#D9564D"; font-color: "#F6DAD6"}
classes.flow.style: {stroke: "#E0B552"; font-color: "#F6E7BE"}
classes.private.style: {stroke: "#7DB077"; font-color: "#D9E8D5"}
